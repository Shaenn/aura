{
  // The tests exercise the BFF, so they compile under the BFF's rules — Node libs,
  // no DOM, `.ts` import extensions. `include` is not inherited through `extends`,
  // hence the repetition; the imported `server/` and `shared/` files are pulled in
  // by the import graph.
  //
  // `paths` mirror Quasar's (see `.quasar/tsconfig.json`) so a DOM-free client
  // helper — `contextRows`, `contextTree` — type-checks when a test imports it.
  // Quasar 3 a retiré `src`, `components` et `app` ; restent `@/` et `shared`,
  // ce dernier déclaré par `quasar.config.ts > build > alias`.
  //
  // Sans `baseUrl` : TypeScript 6 le déprécie comme racine de résolution et 7 le
  // retirera. Depuis la 4.4, `paths` se résout relativement à ce fichier — d'où
  // les `../`, qui disent la même chose que l'ancienne base `..`.
  "extends": "../server/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@": ["../src"],
      "@/*": ["../src/*"],
      "shared": ["../shared"],
      "shared/*": ["../shared/*"]
    }
  },
  "include": ["./**/*.ts"]
}
