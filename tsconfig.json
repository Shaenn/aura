{
  "extends": "./.quasar/tsconfig.json",
  // `test/` runs on Node and imports the BFF with explicit `.ts` extensions, which
  // the Quasar config forbids. It has its own tsconfig, checked by `pnpm typecheck`.
  // `site/` est le site vitrine : sa config est typée par VitePress, pas par le tsconfig
  // de l'application, dont il n'emprunte ni les alias ni le `lib: dom`.
  "exclude": ["./dist", "./idea", "./node_modules", "./.quasar", "./server", "./site", "./test"]
}
