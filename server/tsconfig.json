{
  // The BFF is Node, not the browser: it can't use the Quasar-generated
  // tsconfig (which pulls in `lib: dom` and the `src/` path aliases), and the
  // root tsconfig excludes this folder. Living here also lets ESLint's
  // `projectService` and `tsc` find it without extra wiring.
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true

    // `exactOptionalPropertyTypes` (on for src/, inherited from Quasar) is off
    // here: the BFF builds its DTOs from untyped JSON, so `field: undefined` is
    // the normal way to spell "absent" and the flag only asks for `| undefined`
    // noise on every optional field.
  },
  "include": ["./**/*"]
}
