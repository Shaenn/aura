# Configuration du BFF AURA — CÔTÉ SERVEUR UNIQUEMENT.
# Tout a un défaut local : ce fichier est optionnel. Copier en server/.env si
# besoin de surcharger.

# Port d'écoute du BFF Fastify (le proxy dev de Quasar pointe dessus).
# 8800 et non 8788 : ce dernier est celui d'une autre application locale.
PORT=8800

# Dossier .claude géré par AURA. Défaut : <home>/.claude
# Surcharger p.ex. pour tester sur une copie sandbox.
# AURA_CLAUDE_DIR=C:\Users\jean.dupont\.claude
