{
  "name": "aura",
  "version": "1.3.2",
  "description": "AURA — Assistant Unifié des Ressources Agentiques : poste de pilotage du dossier ~/.claude",
  "productName": "AURA",
  "author": "Shaenn",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "quasar dev",
    "server": "node --env-file-if-exists=server/.env --env-file-if-exists=server/.env.local --watch --import tsx server/index.ts",
    "dev:all": "pnpm stop && concurrently -k -n web,api -c blue,magenta \"pnpm dev\" \"pnpm server\"",
    "stop": "node scripts/free-ports.mjs",
    "build": "quasar build",
    "start": "node --env-file-if-exists=server/.env --env-file-if-exists=server/.env.local --import tsx server/index.ts",
    "preview": "pnpm stop && pnpm build && pnpm start",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --cache-strategy metadata",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --write && pnpm lint:fix",
    "format:check": "prettier . --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifie": "pnpm lint && pnpm typecheck && pnpm test",
    "site:dev": "node scripts/sync-site.mjs && vitepress dev site",
    "site:build": "node scripts/sync-site.mjs && vitepress build site",
    "site:preview": "vitepress preview site",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "@fastify/static": "10.1.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@quasar/extras": "2.0.4",
    "chart.js": "4.5.1",
    "dompurify": "3.4.14",
    "fastify": "5.12.1",
    "highlight.js": "11.12.0",
    "lottie-web": "5.13.0",
    "markdown-it": "15.0.0",
    "mermaid": "11.17.0",
    "node-telegram-bot-api": "2.0.0",
    "pinia": "4.0.3",
    "quasar": "2.26.0",
    "vue": "3.5.41",
    "vue-i18n": "11.4.9",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lehoczky/eslint-config-vitest": "2.1.0",
    "@quasar/app-vite": "3.8.0",
    "@types/node": "24.13.3",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.5",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite-plugin-checker": "0.14.5",
    "vitepress": "1.6.4",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24",
    "pnpm": ">= 11.18.0 <12"
  }
}
