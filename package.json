{
  "name": "aura",
  "version": "1.4.0",
  "description": "AURA — Assistant Unifié des Ressources Agentiques : poste de pilotage du dossier ~/.claude",
  "productName": "AURA",
  "author": "Shaenn",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "quasar dev",
    "server": "node --env-file-if-exists=server/.env --env-file-if-exists=server/.env.local --watch --import tsx server/index.ts",
    "build": "quasar build",
    "start": "node --env-file-if-exists=server/.env --env-file-if-exists=server/.env.local --import tsx server/index.ts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --cache-strategy metadata",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --write && pnpm lint:fix",
    "format:check": "prettier . --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifie": "pnpm lint && pnpm typecheck && pnpm test",
    "site:dev": "node scripts/sync-site.mjs && vitepress dev site",
    "site:build": "node scripts/sync-site.mjs && vitepress build site",
    "site:preview": "vitepress preview site",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@fastify/static": "10.1.6",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@quasar/extras": "2.1.0",
    "chart.js": "4.5.1",
    "dompurify": "3.4.17",
    "fastify": "5.12.7",
    "highlight.js": "11.12.0",
    "lottie-web": "5.13.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "node-telegram-bot-api": "2.1.0",
    "pinia": "4.1.0",
    "quasar": "2.35.2",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lehoczky/eslint-config-vitest": "2.1.0",
    "@quasar/app-vite": "3.10.3",
    "@types/node": "24.19.2",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plugin-checker": "0.14.5",
    "vitepress": "1.6.4",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24",
    "pnpm": ">= 12.5.1 <13"
  }
}
