{
  "name": "aura",
  "version": "1.0.0",
  "description": "AURA — Assistant Unifié des Ressources Agentiques : poste de pilotage du dossier ~/.claude",
  "productName": "AURA",
  "author": "Shaenn",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./server/**/*.ts\" \"./shared/**/*.ts\" \"./test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "dev": "quasar dev",
    "server": "node --watch --import tsx server/index.ts",
    "dev:all": "pnpm stop && concurrently -k -n web,api -c blue,magenta \"quasar dev\" \"node --watch --import tsx server/index.ts\"",
    "stop": "node scripts/free-ports.mjs 8800 9100",
    "start": "tsx server/index.ts",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@fastify/static": "^9.1.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@quasar/extras": "^1.16.4",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.13",
    "fastify": "^5.11.3",
    "highlight.js": "^11.11.1",
    "lottie-web": "^5.13.0",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.1",
    "pinia": "^3.0.1",
    "quasar": "^2.24.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@quasar/app-vite": "^2.5.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.22",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
